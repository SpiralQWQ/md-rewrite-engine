# .env.example — 复制为 .env 并填入真实值（.env 禁止入库）
# 模型 API Key（模型名从 configs 读；Key 从这里读，代码不硬编码）

# ① GLM（智谱）—— quality_check / scoring 用（glm-4.5-air 有额度）
GLM_API_KEY=

# ② Anthropic 通道（可选，当执行者用 anthropic/claude 时）—— 通常已在系统环境配置好；无则在此填
#    ANTHROPIC_AUTH_TOKEN=your-token
#    ANTHROPIC_BASE_URL=https://api.anthropic.com

# ③ DeepSeek（可选，仅当执行者换成 deepseek 时用）
# DEEPSEEK_API_KEY=

# 覆盖 configs 的模型档位（可选；KEY 对应环节：REWRITE / QUALITY_CHECK / RECONCILE / SCORING）
MD_REWRITE_MODEL_REWRITE=
MD_REWRITE_MODEL_QUALITY_CHECK=
MD_REWRITE_MODEL_RECONCILE=
MD_REWRITE_MODEL_SCORING=

# 覆盖执行者 provider（可选；优先级高于 executors.yaml）
# MD_REWRITE_PROVIDER_REWRITE=glm
# MD_REWRITE_PROVIDER_QUALITY_CHECK=glm
